# Google スプレッドシートID（URL の /d/ と /edit の間）
SPREADSHEET_ID=1nM8eejs6VOAM0JNpBS-RyHHGVPxF2j0VU6fGXappLDg
# サービスアカウント鍵（JSON 全体を1行で）。スプレッドシートをこのアカウントに「編集者」で共有すること
GOOGLE_SERVICE_ACCOUNT_JSON=
# セッション Cookie の署名用。長いランダム文字列（例: openssl rand -base64 32）
SESSION_SECRET=
# 1 にするとスプレッドシートの代わりにローカルのモックデータ（.data/mock-db.json）を使う
USE_MOCK_DATA=1
